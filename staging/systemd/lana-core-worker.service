[Unit]
Description=LANA staging read-only queue worker
After=local-fs.target

[Service]
Type=simple
User=lana
Group=lana
WorkingDirectory=/opt/lana
Environment=PYTHONPATH=/opt/lana
ExecStart=/usr/bin/python3 -m lana_core.cli --db /var/lib/lana/lana.sqlite3 daemon --interval 10
Restart=always
RestartSec=5
UMask=0077
StateDirectory=lana
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/lana
CapabilityBoundingSet=
SystemCallArchitectures=native
TimeoutStopSec=15
MemoryMax=128M

[Install]
WantedBy=multi-user.target
