# EXAMPLE ONLY. NEVER put real tokens into GitHub or a chat.
# Generate random secrets on the staging server and store this file as
# /etc/lana/lana.env, owned by root, mode 0600.
# Quotes are needed if values include spaces, quotes or special characters.
LANA_API_TOKEN=REPLACE_WITH_SECURE_RANDOM_TOKEN_OF_48_CHARS_OR_MORE
OPENAI_API_KEY=REPLACE_WITH_SERVER_ONLY_OPENAI_API_KEY
LANA_OPENAI_MODEL=gpt-4.1-mini
